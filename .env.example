TELEGRAM_BOT_TOKEN=replace_me

# Optional: choose where SQLite data is stored
STONKER_DB_PATH=./investments.db

# Optional: stock providers. Supported: stocksocket, yahoo, stooq
# Use one provider, or comma-separated providers for combined updates/fallbacks.
STONKER_STOCK_PROVIDERS=stocksocket

# Optional: if stocksocket is configured but unavailable at startup, fall back to yahoo.
STONKER_AUTO_FALLBACK=true
STONKER_REALTIME_CHECK_TIMEOUT_MS=5000

# Optional: polling providers only (yahoo/stooq). Minimum enforced: 15000.
STONKER_POLL_INTERVAL_MS=60000

# Optional: Stooq default suffix for bare tickers like AAPL -> aapl.us
STONKER_STOOQ_SUFFIX=.us
